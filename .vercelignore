# Local env files must never ship in deployments: Vercel project env vars are
# the source of truth (bun env:vercel:*), and frameworks like Next.js would
# otherwise load these localhost values at runtime.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!.env.schema
!**/.env.schema
local.db
local.db-*
.alchemy/
# Build outputs and caches: Vercel builds from source, and these can exceed the
# per-file upload limit.
.turbo
**/.turbo
**/.next
**/dist
**/.expo
**/*.tsbuildinfo
